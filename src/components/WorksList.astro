---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { ui, type Lang } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const works = (await getCollection('works', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base lang={lang} page="works" title={t.works}>
  <section class="reveal">
    <h1>{t.works}</h1>
    {
      works.length === 0 ? (
        <p class="muted">{t.todoWorks}</p>
      ) : (
        <ul>
          {works.map((w) => (
            <li>
              <a href={`${base}/works/${w.id}/`}>{w.data.title}</a>
              <span class="muted"> - {w.data.summary}</span>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>
