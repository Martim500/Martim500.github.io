---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site, links, ui, path, type Lang } from '../data/site';
import { credentials } from '../data/career';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const works = (await getCollection('works', ({ data }) => !data.draft))
  .filter((w) => w.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base lang={lang} page="">
  <section class="reveal">
    <h1>{site.name}</h1>
    <p class="muted">{site.tagline[lang]}</p>
  </section>

  <section class="reveal">
    <h2>{t.career}</h2>
    <ul>
      {credentials.map((c) => <li>{c.title[lang]}</li>)}
    </ul>
    <p><a href={`${base}${path(lang, 'about')}`}>{t.about} →</a></p>
    <p><a href={`${base}${path(lang, 'talks')}`}>{t.talks} →</a></p>
  </section>

  <section class="reveal">
    <h2>{t.works}</h2>
    {
      works.length === 0 ? (
        <p class="muted">{t.todoWorks}</p>
      ) : (
        <ul>
          {works.map((w) => (
            <li>
              <a href={`${base}/works/${w.id}/`}>{w.data.title}</a>
              <span class="muted"> - {w.data.summary}</span>
            </li>
          ))}
        </ul>
      )
    }
    <p><a href={`${base}${path(lang, 'works')}`}>{t.works} →</a></p>
  </section>

  <section class="reveal">
    <h2>{t.links}</h2>
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={l.url} rel="noopener noreferrer">{l.label}</a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
