---
import Base from '../layouts/Base.astro';
import { ui, type Lang } from '../data/site';
import { intro, credentials } from '../data/career';
import { talks } from '../data/talks';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---

<Base lang={lang} page="about" title={t.about}>
  <section class="reveal">
    <h1>{t.about}</h1>
    {intro.map((p) => <p>{p[lang]}</p>)}
  </section>

  <section class="reveal">
    <h2>{t.career}</h2>
    <ul class="entries">
      {
        credentials.map((c) => (
          <li>
            {c.year && <span class="date">{c.year}</span>}
            {c.title[lang]}
          </li>
        ))
      }
    </ul>
  </section>

  {
    talks.length > 0 && (
      <section class="reveal">
        <h2>{t.activity}</h2>
        <p>
          {t.talkCount}: {talks.length}
          {t.timesSuffix}
        </p>
      </section>
    )
  }
</Base>
