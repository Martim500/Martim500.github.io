---
import Base from '../layouts/Base.astro';
import { ui, type Lang } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---

<Base lang={lang} page="about" title={t.about}>
  <section class="reveal">
    <h1>{t.about}</h1>
    <p class="muted">{t.todoAbout}</p>
  </section>
</Base>
