---
import Base from '../layouts/Base.astro';
import { ui, path, type Lang } from '../data/site';
import { diagrams } from '../data/diagrams';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = lang === 'ja' ? '' : '/en';
---

<Base lang={lang} page="diagrams" title={t.diagrams}>
  <section class="reveal">
    <h1>{t.diagrams}</h1>
    {
      diagrams.length === 0 ? (
        <p class="muted">{t.preparing}</p>
      ) : (
        <ul class="entries">
          {diagrams.map((d) => (
            <li>
              <a href={`${base}${prefix}/diagrams/${d.slug}/`}><strong>{d.title[lang]}</strong></a>
              <div class="meta">{d.summary[lang]}</div>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>
