---
import { site, ui, path, type Lang, type Page } from '../data/site';

interface Props {
  title?: string;
  lang?: Lang;
  // 切り替え先(もう一方の言語)のページ種別。省略時は切り替えリンクを出さない
  page?: Page;
  // 詳細ページなど、切り替え先を個別に指定する場合のパス(例: /en/diagrams/foo/)
  altPath?: string;
}
const { title, lang = 'ja', page, altPath } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'ja' ? 'en' : 'ja';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageTitle = title ? `${title} | ${site.title}` : site.title;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- 検索エンジンには当面載せない(確認事項 G1)。載せる時にこの行を削除する -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <header>
      <a class="brand" href={`${base}${path(lang, '')}`}>{site.title}</a>
      <nav>
        <a href={`${base}${path(lang, 'about')}`}>{t.about}</a>
        <a href={`${base}${path(lang, 'works')}`}>{t.works}</a>
        <a href={`${base}${path(lang, 'talks')}`}>{t.talks}</a>
        <a href={`${base}${path(lang, 'tools')}`}>{t.tools}</a>
        <a href={`${base}${path(lang, 'diagrams')}`}>{t.diagrams}</a>
        <a href={`${base}${path(lang, 'services')}`}>{t.services}</a>
        {
          (page !== undefined || altPath) && (
            <a class="lang" href={altPath ? `${base}${altPath}` : `${base}${path(other, page as Page)}`} lang={other}>
              {t.switchLabel}
            </a>
          )
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <small>&copy; {new Date().getFullYear()} {site.name}</small>
    </footer>
    <script is:inline>
      // スクロールに応じてコンテンツを順に表示する。動きを減らす設定の人には適用しない。
      (function () {
        var els = document.querySelectorAll('.reveal');
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach(function (e) { e.classList.add('in'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) {
              en.target.classList.add('in');
              io.unobserve(en.target);
            }
          });
        }, { threshold: 0.15 });
        els.forEach(function (e) { io.observe(e); });
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fff;
    --fg: #1d1d1f;
    --muted: #6e6e73;
    --line: #d2d2d7;
    --accent: #0066cc;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #000;
      --fg: #f5f5f7;
      --muted: #a1a1a6;
      --line: #333336;
      --accent: #2997ff;
    }
  }
  body {
    margin: 0 auto;
    max-width: 48rem;
    padding: 0 1.25rem;
    background: var(--bg);
    color: var(--fg);
    font-family: -apple-system, system-ui, 'Segoe UI', 'Hiragino Sans', 'Yu Gothic', sans-serif;
    line-height: 1.8;
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 1.5rem 0 1rem;
    border-bottom: 1px solid var(--line);
  }
  header {
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  header nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }
  .entries {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .entries li {
    padding: 0.75rem 0;
    border-top: 1px solid var(--line);
  }
  .entries .date {
    display: block;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .entries .meta {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  h3 {
    font-size: 1.125rem;
    margin: 2rem 0 0.5rem;
  }
  .brand {
    font-weight: 600;
    color: inherit;
    text-decoration: none;
  }
  a {
    color: var(--accent);
  }
  main {
    padding: 2rem 0;
  }
  section {
    margin: 0 0 7rem;
  }
  h1 {
    font-size: clamp(2.25rem, 7vw, 3.5rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 4rem 0 1rem;
  }
  h2 {
    font-size: clamp(1.5rem, 4vw, 2rem);
    margin: 0 0 1rem;
  }
  footer {
    padding: 1rem 0 2rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }
  .muted {
    color: var(--muted);
  }
  /* スクロール表示。JSが無い環境では常に表示する */
  .js .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }
  .js .reveal.in {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .js .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
