---
import { site } from '../data/site';

interface Props {
  title?: string;
}
const { title } = Astro.props;
const pageTitle = title ? `${title} | ${site.title}` : site.title;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header>
      <a class="brand" href={`${base}/`}>{site.title}</a>
      <nav>
        <a href={`${base}/about/`}>About</a>
        <a href={`${base}/works/`}>Works</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <small>&copy; {new Date().getFullYear()} {site.name}</small>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --fg: #222;
    --muted: #666;
    --line: #ddd;
    --accent: #0b5fff;
  }
  body {
    margin: 0 auto;
    max-width: 44rem;
    padding: 0 1rem;
    color: var(--fg);
    font-family: system-ui, -apple-system, 'Segoe UI', 'Hiragino Sans', 'Yu Gothic', sans-serif;
    line-height: 1.8;
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 1.5rem 0 1rem;
    border-bottom: 1px solid var(--line);
  }
  header nav a {
    margin-left: 1rem;
  }
  .brand {
    font-weight: 700;
    color: inherit;
    text-decoration: none;
  }
  a {
    color: var(--accent);
  }
  main {
    padding: 2rem 0;
  }
  footer {
    padding: 1rem 0 2rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }
  .muted {
    color: var(--muted);
  }
</style>
