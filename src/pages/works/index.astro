---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const works = (await getCollection('works', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base title="Works">
  <h1>Works</h1>
  {
    works.length === 0 ? (
      <p class="muted">TODO: 作成サイト一覧(回答待ち)</p>
    ) : (
      <ul>
        {works.map((w) => (
          <li>
            <a href={`${base}/works/${w.id}/`}>{w.data.title}</a>
            <span class="muted"> - {w.data.summary}</span>
          </li>
        ))}
      </ul>
    )
  }
</Base>
